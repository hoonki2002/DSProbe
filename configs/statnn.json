{
  "description": "Historical server StatNN: seven statistics per named parameter over the full model, followed by a 100-output XGBoost membership classifier. Not the original LightGBM accuracy-regression task.",
  "task": "membership",
  "input_scope": "all_named_parameters",
  "models": [
    "ResNet",
    "SupViT",
    "MAE",
    "DINO"
  ],
  "hyperparameters": {
    "n_estimators": 500,
    "early_stopping_rounds": 25,
    "learning_rate": 0.05,
    "max_depth": 3,
    "subsample": 0.9,
    "colsample_bytree": 1.0,
    "reg_lambda": 1.0,
    "reg_alpha": 0.0,
    "tree_method": "hist",
    "device": "cpu",
    "n_jobs": 4
  },
  "methods": [
    "statnn"
  ],
  "seeds": [
    1,
    2,
    3,
    4,
    5
  ]
}
